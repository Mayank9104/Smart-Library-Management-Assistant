# Application Settings
APP_NAME="AI-Powered Smart Library Management Assistant"
ENVIRONMENT="development"
API_HOST="127.0.0.1"
API_PORT=8000
BACKEND_URL="http://127.0.0.1:8000"

# LLM Provider Selection: "groq" or "local"
LLM_PROVIDER="groq"

# Groq Configuration (Cloud LLM)
GROQ_API_KEY="YOUR_SECRET_KEY"
GROQ_MODEL="llama-3.3-70b-versatile"

# Local LLM Configuration (Ollama)
LOCAL_LLM_BASE_URL="http://localhost:11434"
LOCAL_LLM_MODEL="llama3.2"

# Semantic Search Embeddings (Local HuggingFace Model for ChromaDB)
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"

# Database & Vector Store Paths
SQLITE_DB_URL="sqlite:///./data/library.db"
CHROMA_PERSIST_DIR="./data/chroma_db"